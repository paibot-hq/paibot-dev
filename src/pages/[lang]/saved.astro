---
import Base from '../../layouts/Base.astro';
import Feed from '../../components/Feed.astro';
import PageHeading from '../../components/PageHeading.astro';
import { t, langs } from '../../i18n/utils.js';
import { getArticles } from '../../lib/articles.js';

export function getStaticPaths() { return langs.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
const articles = await getArticles(lang);
---
<Base lang={lang} title={`${t(lang, 'saved')} | PAIBOT.dev`}>
  <div class="container subpage">
    <PageHeading en="EXPLORE ARTICLES" title={t(lang, 'listTitle')} description={t(lang, 'listText')} />
    <Feed lang={lang} articles={articles} filter="saved" />
  </div>
</Base>
