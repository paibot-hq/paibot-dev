---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { t } from '../i18n/utils.js';

// Google AdSense パブリッシャーID(ca-pub-…)。AdSenseに登録して発行されたら入れる。空の間は何も出力しない。
// ID を入れたら public/ads.txt も作る(google.com, pub-…, DIRECT, f08c47fec0942fa0)。
const ADSENSE_CLIENT = 'ca-pub-8043848570527700';

const { lang, title, description = t(lang, 'metaDescription') } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f9fa" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <noscript><style>.code-panel[hidden] { display: block !important; } .code-tabs .code-tablist { display: none !important; }</style></noscript>
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    {ADSENSE_CLIENT && <script is:inline async crossorigin="anonymous" src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}></script>}
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem('paibot-theme'); } catch (e) {}
        if (theme !== 'dark' && theme !== 'light') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#0f1216' : '#f8f9fa');
      })();
    </script>
  </head>
  <body data-lang={lang}>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} pathname={Astro.url.pathname} />
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer"><div class="footer-inner"><a class="wordmark footer-wordmark" href={`/${lang}/`}>PAIBOT<span class="domain">.dev</span></a><p>IMPLEMENTATION, REASONING &amp; FIELD NOTES.</p><span>© 2026 PAIBOT.dev</span></div></footer>
    <div id="toast" role="status" aria-live="polite"></div>
    <SearchDialog lang={lang} />
    <script type="application/json" id="i18n-data" set:html={JSON.stringify(Object.fromEntries(
      ['copied', 'copyFailed', 'savedToast', 'unsavedToast', 'storageLimited', 'themeToDark', 'themeToLight', 'searchIdle', 'searchNone', 'emptyNone', 'emptyNoneText'].map(key => [key, t(lang, key)])
        .concat([['searchCountOne', t(lang, 'searchCount', 1)], ['searchCountMany', t(lang, 'searchCount', 2)], ['saveLabel', t(lang, 'saveLabel', '{title}')], ['unsaveLabel', t(lang, 'unsaveLabel', '{title}')]])
    ))} />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
